---
import { site } from "../data/site";
---

<section class="hero section">
  <div class="container hero-shell">
    <div class="badge reveal">
      <img src="/photos/Nathan.png" alt="Nathan Winklepleck" />
      <p>{site.owner} | {site.youtubeStat}</p>
    </div>

    <p class="kicker reveal delay-1">Videography and Social Strategy</p>
    <h1 class="reveal delay-1">Media that makes your business look trustworthy from the first impression.</h1>
    <p class="lead reveal delay-2">
      Winklepleck Media combines creator-level storytelling with business-first execution, from testimonial films and
      event coverage to strategic content that helps serious companies stand out.
    </p>

    <div class="actions reveal delay-2">
      <a class="button primary" href="/contact">Book a Consultation</a>
      <a class="button secondary" href="/portfolio">View Portfolio</a>
    </div>

    <div class="hero-visual reveal delay-2" aria-hidden="true">
      <div class="glow"></div>
      <div class="media-card">
        <img src="/photos/Nathan.png" alt="" />
      </div>
      <div class="stat-chip one">Event, Brand, and Testimonial Production</div>
      <div class="stat-chip two">Serving Indiana and beyond</div>
    </div>

    <div class="pills reveal delay-2" aria-label="Core services">
      <span>Social Media Consulting</span>
      <span>Full-Production Videography</span>
      <span>Testimonial Films</span>
      <span>Weddings & Events</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 5.5rem;
  }

  .hero-shell {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background:
      radial-gradient(90% 150% at 100% 0%, rgba(179, 131, 77, 0.2), rgba(179, 131, 77, 0) 60%),
      rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-soft);
    padding: clamp(1.2rem, 4vw, 2.5rem);
  }

  h1 {
    margin: 0.1rem 0 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.35rem, 6vw, 4.9rem);
    line-height: 0.98;
    letter-spacing: 0.01em;
    max-width: 16ch;
  }

  .lead {
    max-width: 64ch;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
  }

  .badge img {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .badge p {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-visual {
    margin-top: 1.4rem;
    position: relative;
    min-height: 300px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(130deg, #f6e9d6, #efe2d2 45%, #e9d8c2 100%);
  }

  .glow {
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(179, 131, 77, 0.45), rgba(179, 131, 77, 0));
    right: -75px;
    top: -80px;
  }

  .media-card {
    position: absolute;
    left: clamp(0.8rem, 2vw, 1.4rem);
    right: clamp(0.8rem, 2vw, 1.4rem);
    bottom: clamp(0.8rem, 2vw, 1.4rem);
    top: clamp(0.8rem, 2vw, 1.4rem);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(23, 21, 18, 0.16);
    box-shadow: 0 22px 40px rgba(23, 21, 18, 0.16);
  }

  .media-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.08), rgba(17, 17, 17, 0.35));
    pointer-events: none;
  }

  .media-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .stat-chip {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(5px);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .stat-chip.one {
    left: 1rem;
    top: 1rem;
  }

  .stat-chip.two {
    right: 1rem;
    bottom: 1rem;
  }

  .pills {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .pills span {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    padding: 0.4rem 0.72rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 4.5rem;
    }

    .hero-shell {
      padding: 1.1rem;
    }

    .hero-visual {
      min-height: 250px;
    }

    .stat-chip {
      font-size: 0.72rem;
    }
  }
</style>
