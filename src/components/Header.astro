---
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/contact", label: "Contact" }
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">Winklepleck Media</a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class={path === link.href ? "active" : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(7px);
    background: rgba(250, 248, 244, 0.85);
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  ul {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
    font-weight: 600;
  }

  a {
    opacity: 0.82;
  }

  a.active,
  a:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    nav {
      overflow-x: auto;
      max-width: 63vw;
    }

    ul {
      white-space: nowrap;
      padding-bottom: 0.15rem;
    }
  }
</style>
