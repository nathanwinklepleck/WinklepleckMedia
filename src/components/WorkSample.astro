---
interface Props {
  title: string;
  category: string;
  description: string;
  result: string;
  videoUrl?: string;
  siteUrl?: string;
}

const { title, category, description, result, videoUrl, siteUrl } = Astro.props;

const getEmbedUrl = (url?: string) => {
  if (!url) {
    return undefined;
  }

  if (url.includes("youtu.be/")) {
    const id = url.split("youtu.be/")[1]?.split(/[?&#]/)[0];
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }

  if (url.includes("youtube.com/watch")) {
    const parsedUrl = new URL(url);
    const id = parsedUrl.searchParams.get("v");
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }

  return url;
};

const embedUrl = getEmbedUrl(videoUrl);
const thumbnailUrl = embedUrl
  ? `${embedUrl.replace("/embed/", "/vi/")}/hqdefault.jpg`.replace("https://www.youtube.com/vi/", "https://i.ytimg.com/vi/")
  : undefined;
---

<article class="sample reveal">
  <div class="media-frame">
    {embedUrl ? (
      <button
        class="video-poster"
        type="button"
        data-video-embed={embedUrl}
        data-video-title={title}
        aria-label={`Play ${title}`}
      >
        {thumbnailUrl && <img src={thumbnailUrl} alt={title} loading="lazy" />}
        <span class="play-badge">Play Sample</span>
      </button>
    ) : siteUrl ? (
      <div class="site-preview">
        <div class="browser-bar">
          <span></span><span></span><span></span>
          <p>{siteUrl.replace(/^https?:\/\//, "")}</p>
        </div>
        <iframe src={siteUrl} title={title} loading="lazy"></iframe>
      </div>
    ) : (
      <div class="empty-state">Preview coming soon</div>
    )}
  </div>
  <div class="content">
    <p class="category">{category}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <p class="result">{result}</p>
    <div class="links">
      {videoUrl && (
        <a href={videoUrl} target="_blank" rel="noreferrer" class="button secondary">Open Video</a>
      )}
      {siteUrl && (
        <a href={siteUrl} target="_blank" rel="noreferrer" class="button secondary">Visit Website</a>
      )}
    </div>
  </div>
</article>

<style>
  .sample {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-soft);
  }

  .media-frame {
    background: #111;
    border-bottom: 1px solid var(--color-line);
  }

  .media-frame iframe,
  .empty-state {
    width: 100%;
    min-height: 280px;
    border: 0;
    display: block;
  }

  .video-poster {
    position: relative;
    width: 100%;
    min-height: 280px;
    border: 0;
    padding: 0;
    background: #111;
    cursor: pointer;
    display: block;
  }

  .video-poster img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    filter: saturate(0.92) contrast(1.02);
  }

  .video-poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.1), rgba(17, 17, 17, 0.45));
  }

  .play-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 1;
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.92);
    color: var(--color-ink);
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .site-preview {
    background: #f2ebe2;
  }

  .browser-bar {
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.85rem;
    border-bottom: 1px solid var(--color-line);
    background: #efe4d7;
  }

  .browser-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #c8b49d;
  }

  .browser-bar p {
    margin: 0 0 0 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .empty-state {
    display: grid;
    place-items: center;
    color: #f5efe6;
  }

  .content {
    padding: 1.2rem;
  }

  .category {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.74rem;
    color: var(--color-accent-deep);
    font-weight: 700;
  }

  h3 {
    margin: 0.45rem 0;
    font-size: 1.3rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .result {
    margin-top: 0.7rem;
    color: var(--color-ink);
    font-weight: 600;
  }

  .links {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 780px) {
    .media-frame iframe,
    .empty-state,
    .video-poster,
    .video-poster img {
      min-height: 220px;
    }
  }
</style>

<script>
  const createVideoFrame = (embedUrl, title) => {
    const frame = document.createElement("iframe");
    frame.src = `${embedUrl}?autoplay=1`;
    frame.title = title;
    frame.loading = "lazy";
    frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    frame.allowFullscreen = true;
    return frame;
  };

  document.querySelectorAll(".video-poster[data-video-embed]").forEach((button) => {
    button.addEventListener("click", () => {
      const embedUrl = button.getAttribute("data-video-embed");
      const title = button.getAttribute("data-video-title") || "Video sample";

      if (!embedUrl) {
        return;
      }

      button.replaceWith(createVideoFrame(embedUrl, title));
    });
  });
</script>