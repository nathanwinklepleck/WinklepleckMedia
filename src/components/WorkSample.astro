---
interface Props {
  title: string;
  category: string;
  description: string;
  result: string;
  videoUrl?: string;
  siteUrl?: string;
}

const { title, category, description, result, videoUrl, siteUrl } = Astro.props;

const getEmbedUrl = (url?: string) => {
  if (!url) {
    return undefined;
  }

  if (url.includes("youtu.be/")) {
    const id = url.split("youtu.be/")[1]?.split(/[?&#]/)[0];
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }

  if (url.includes("youtube.com/watch")) {
    const parsedUrl = new URL(url);
    const id = parsedUrl.searchParams.get("v");
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }

  return url;
};

const embedUrl = getEmbedUrl(videoUrl);
---

<article class="sample reveal">
  <div class="media-frame">
    {embedUrl ? (
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    ) : siteUrl ? (
      <iframe src={siteUrl} title={title} loading="lazy"></iframe>
    ) : (
      <div class="empty-state">Preview coming soon</div>
    )}
  </div>
  <div class="content">
    <p class="category">{category}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <p class="result">{result}</p>
    <div class="links">
      {videoUrl && (
        <a href={videoUrl} target="_blank" rel="noreferrer" class="button secondary">Open Video</a>
      )}
      {siteUrl && (
        <a href={siteUrl} target="_blank" rel="noreferrer" class="button secondary">Visit Website</a>
      )}
    </div>
  </div>
</article>

<style>
  .sample {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-soft);
  }

  .media-frame {
    background: #111;
    border-bottom: 1px solid var(--color-line);
  }

  .media-frame iframe,
  .empty-state {
    width: 100%;
    min-height: 280px;
    border: 0;
    display: block;
  }

  .empty-state {
    display: grid;
    place-items: center;
    color: #f5efe6;
  }

  .content {
    padding: 1.2rem;
  }

  .category {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.74rem;
    color: var(--color-accent-deep);
    font-weight: 700;
  }

  h3 {
    margin: 0.45rem 0;
    font-size: 1.3rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .result {
    margin-top: 0.7rem;
    color: var(--color-ink);
    font-weight: 600;
  }

  .links {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 780px) {
    .media-frame iframe,
    .empty-state {
      min-height: 220px;
    }
  }
</style>