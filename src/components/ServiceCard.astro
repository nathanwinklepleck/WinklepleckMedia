---
interface Props {
  title: string;
  summary: string;
  includes: string[];
}

const { title, summary, includes } = Astro.props;
---

<article class="card reveal">
  <h3>{title}</h3>
  <p>{summary}</p>
  <ul>
    {includes.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</article>

<style>
  .card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.35rem;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: var(--shadow-soft);
  }

  h3 {
    margin: 0 0 0.65rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.75rem;
    line-height: 1.05;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  ul {
    margin: 0.95rem 0 0;
    padding-left: 1.1rem;
    color: var(--color-ink);
  }

  li + li {
    margin-top: 0.4rem;
  }
</style>
