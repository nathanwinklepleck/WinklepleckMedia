---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import { portfolioItems } from "../data/portfolio";
---

<Layout title="Portfolio | Winklepleck Media" description="Selected work spanning commercial films, social campaigns, testimonials, and events.">
  <section class="section">
    <div class="container">
      <SectionHeading
        kicker="Portfolio"
        title="Selected work across business storytelling and events."
        lead="Featured projects include client testimonial and promotional films with direct links so visitors can watch the work immediately."
      />
      <div class="grid">
        {portfolioItems.map((item) => <PortfolioCard {...item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .grid {
    margin-top: 1.4rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 780px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
