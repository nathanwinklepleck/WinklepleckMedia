---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkSample from "../components/WorkSample.astro";
import { portfolioItems } from "../data/portfolio";
---

<Layout title="Portfolio | Winklepleck Media" description="Selected work spanning commercial films, social campaigns, testimonials, and events.">
  <section class="section">
    <div class="container">
      <SectionHeading
        kicker="Portfolio"
        title="Selected client work visitors can experience directly on the page."
        lead="Current featured samples include two embedded video projects and one live website preview so prospects can evaluate the work immediately."
      />
      <div class="grid">
        {portfolioItems.map((item) => <WorkSample {...item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .grid {
    margin-top: 1.4rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 780px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
